# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Shared secret between the app and the sandbox worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_CALLBACK_SECRET=

# Vercel Blob. When the store is connected to the project, Vercel injects
# either BLOB_READ_WRITE_TOKEN or the OIDC pair (BLOB_STORE_ID +
# VERCEL_OIDC_TOKEN). Nothing to add here in production; `vercel env pull`
# fills these for local development.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------

# Public base URL of the deployment. Used by the in-sandbox worker to call
# back. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, then to
# the request origin. Set it for local development behind a tunnel.
# APP_BASE_URL=

# Blob store access level: "public" or "private". Use "public" so the final
# file can be served with ?download=1 directly. "private" issues short-lived
# signed download URLs instead.
# BLOB_ACCESS=public

# Optional shared code. When set, the form asks for it and POST /api/jobs
# rejects submissions without it.
# APP_ACCESS_CODE=

# Maximum jobs in flight, running plus waiting. Submissions beyond this get a
# busy response. 2 means one running plus one waiting.
# MAX_PENDING_JOBS=2

# Name of the persistent worker sandbox.
# SANDBOX_NAME=grabbit-worker

# Session timeout in minutes. Pro allows up to 1440 (24h); Hobby caps at 45.
# The app falls back to 45 automatically if a larger value is rejected.
# SANDBOX_TIMEOUT_MINUTES=1440

# Pinned yt-dlp release installed inside the sandbox.
# YTDLP_VERSION=2026.08.19

# Base64-encoded Netscape cookies.txt from a signed-in YouTube session. The
# worker decodes it to cookies.txt and passes --cookies to yt-dlp. Required
# for age-restricted/members-only videos and for the "Sign in to confirm
# you're not a bot" check. See "Signed-in downloads" in the README.
# YTDLP_COOKIES_BASE64=

# How long completed and failed job records plus their output files are kept.
# OUTPUT_TTL_HOURS=24

# Reject videos longer than this (0 disables the check).
# MAX_DURATION_MINUTES=720

# Attempts per job before it is marked failed.
# MAX_ATTEMPTS=3

# Largest output accepted, in gigabytes.
# MAX_OUTPUT_GB=40

# No progress for this many minutes marks a job as stalled and restarts it.
# STALL_MINUTES=10

# Minimum seconds between sandbox status syncs from the status endpoint.
# SYNC_MIN_INTERVAL_SECONDS=4

# Delete the stopped worker sandbox (and its snapshots) after this many idle
# hours. Tools are reinstalled on the next job.
# SANDBOX_IDLE_DELETE_HOURS=24

# How long the worker sandbox snapshot is kept between sessions.
# SNAPSHOT_TTL_DAYS=7

# Protect /api/cron/reconcile. On Vercel, cron invocations automatically send
# "Authorization: Bearer $CRON_SECRET" when this variable is set.
# CRON_SECRET=
